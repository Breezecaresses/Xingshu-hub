{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XingShu Hub",
  "version": "0.1.6-beta.2",
  "identifier": "com.xingshu.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "星枢 Hub",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:28848 https://124.221.176.134 https://astralparty-xingshu.lanxichaxu.cn"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
