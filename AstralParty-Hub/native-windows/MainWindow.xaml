<Window x:Class="XingShu.Native.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="星枢 Hub · Windows 原生版" Style="{StaticResource {x:Type Window}}" Width="1220" Height="810" MinWidth="900" MinHeight="620" Icon="Brand/icon.ico" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Grid x:Name="AppGrid" Background="{StaticResource Bg}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
    <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,1" Padding="20,15">
      <StackPanel Orientation="Horizontal"><Image Source="Brand/logo.png" Width="40" Height="40" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="星枢 Hub" FontSize="18" FontWeight="Bold"/><TextBlock Text="WINDOWS NATIVE" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></StackPanel>
    </Border>
    <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,15,16,8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Breadcrumb" Text="工作台 / 总览" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,12,0"/>
        <StackPanel Orientation="Horizontal" Grid.Column="1"><ComboBox x:Name="AccountPicker" Width="215" AutomationProperties.Name="查看账号" DisplayMemberPath="Label" SelectedValuePath="Key"/><Button x:Name="RefreshButton" Content="刷新" ToolTip="刷新当前页面 (Ctrl+R)"/></StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><ScrollViewer><StackPanel x:Name="Navigation" Margin="12,14,4,14"/></ScrollViewer></Border>
    <Grid Grid.Column="1" Grid.Row="1"><ScrollViewer x:Name="PageScroll" Padding="28,25,18,24"><StackPanel x:Name="PageBody"/></ScrollViewer>
      <Border x:Name="BusyIndicator" VerticalAlignment="Top" Background="{StaticResource Accent}" Height="2" Visibility="Collapsed"/>
    </Grid>
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource Raised}" Padding="15,5"><DockPanel LastChildFill="True"><TextBlock Text="WPF · Rust  /  0.2.0-native1" FontSize="10" Foreground="{StaticResource Muted}" DockPanel.Dock="Right"/><TextBlock x:Name="StatusText" Text="正在连接本地核心…" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
    <Border x:Name="Toast" Grid.Column="1" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="700" Background="#30334F" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="10" Margin="20" Padding="18" Visibility="Collapsed"><TextBlock x:Name="ToastText"/></Border>
  </Grid>
</Window>
